{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sonix AI Analysis Folders API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Folders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List folders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sonix.ai/v1/folders"
          },
          "docs": "Lists all folders in your account."
        },
        {
          "info": {
            "name": "Create folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sonix.ai/v1/folders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new folder to organize media."
        },
        {
          "info": {
            "name": "Update folder",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.sonix.ai/v1/folders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the folder."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a folder's properties."
        }
      ]
    }
  ],
  "bundled": true
}